---
import contractIcon from "../assets/svg_imgs/contract.svg";

export interface Props {
  brandLabel?: string;
  homeHref?: string;
}

const { brandLabel = "skicyclerun", homeHref = "/" } = Astro.props;
---

<div class="full-view-topbar" role="navigation" aria-label="Full view controls">
  <a href={homeHref} class="full-view-brand" aria-label="Home">SkiCycleRun</a>
  <button
    type="button"
    id="exit-full-page"
    class="full-view-exit"
    aria-label="Exit full view"
    title="Exit full view"
  >
    <img src={contractIcon.src} alt="" class="icon-btn" />
  </button>
</div>

<style>
  .full-view-topbar {
    display: none;
    align-items: center;
    justify-content: space-between;
    width: min(100% - 0.8rem, 960px);
    position: fixed;
    top: max(0.35rem, env(safe-area-inset-top));
    left: 50%;
    transform: translateX(-50%);
    z-index: 165;
    padding: 0.28rem 0.34rem;
    border-radius: 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.2);
    background: rgba(0, 0, 0, 0.42);
    backdrop-filter: blur(10px) saturate(135%);
    -webkit-backdrop-filter: blur(10px) saturate(135%);
  }

  .full-view-brand {
    color: rgba(255, 255, 255, 0.96);
    font-weight: 700;
    letter-spacing: 0.02em;
    font-size: 1.1rem;
    text-transform: none;
    padding: 0.22rem 0.48rem;
    border-radius: 999px;
  }

  .full-view-exit {
    border: 1px solid rgba(255, 255, 255, 0.34);
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.52);
    line-height: 1;
    width: 1.5rem;
    height: 1.5rem;
    padding: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .full-view-exit .icon-btn {
    display: block;
    width: 0.75rem;
    height: 0.75rem;
    filter: invert(1) brightness(1.1);
  }

  @media (max-width: 768px) {
    .full-view-topbar {
      width: calc(100vw - 0.48rem);
      top: max(0.2rem, env(safe-area-inset-top));
      border-radius: 0.62rem;
      padding: 0.24rem 0.26rem;
    }

    .full-view-brand {
      font-size: 0.95rem;
      padding: 0.2rem 0.42rem;
    }

    .full-view-exit {
      width: 1.5rem;
      height: 1.5rem;
      padding: 0;
    }
  }
</style>
