---
import { normalizePhotoIndex } from "../utils/photoViewState";

const { photos = [], frontmatter = {}, initialIndex = 0 } = Astro.props;
const activeIndex = normalizePhotoIndex(initialIndex, photos.length, 0);
const first = photos && photos.length ? photos[activeIndex] || photos[0] : null;
---

<div class="mdx-hero">
  {first ? (
  <figure
    class="hero-figure"
    data-photos-json
    data-active-photo-index={activeIndex}
    style={`--hero-bg: url('${first.src}')`}
  >
      <!-- Embed the photo list using Astro-recommended JSON block, scoped near usage -->
      <script
        type="application/json"
        id="hero-photos"
        set:html={JSON.stringify(photos).replace(/</g, '\\u003c')}
      />

      <img
        src={first.src}
        alt={first.alt ?? first.altText ?? frontmatter.title ?? "Hero image"}
        loading="lazy"
        decoding="async"
        data-current-index={activeIndex}
        class="hero-image"
        draggable="false"
        style="cursor: pointer;"
      />
      <!-- Photo counter pill -->
      <div id="hero-counter" class="hero-counter-pill">
        {photos.length > 1 ? `1 / ${photos.length}` : ''}
      </div>
      {frontmatter.title && (
        <figcaption class="hero-caption text-sm text-skin-muted">
          {frontmatter.title}
        </figcaption>
      )}

        <script>
          import {
            PHOTO_ACTIVE_INDEX_CHANGE_EVENT,
            normalizePhotoIndex,
          } from "../utils/photoViewState";

          (() => {
            const debugLogger = window as typeof window & {
              debugLog?: (...args: any[]) => void;
            };
            const debug = typeof debugLogger.debugLog === "function"
              ? (...args: any[]) => debugLogger.debugLog?.("ui", ...args)
              : () => {};

            function init() {
              debug("[Hero] init() called");
              const container = document.querySelector<HTMLElement>("figure[data-photos-json]");
              if (!container) {
                debug("[Hero] No container found");
                return;
              }

              if (container.dataset.heroInitialized === "1") {
                debug("[Hero] Already initialized");
                return;
              }

              const img = container.querySelector<HTMLImageElement>("img");
              if (!img) {
                debug("[Hero] No img found");
                return;
              }

              const heroContainer = container;
              const heroImg = img;

              const counterEl = container.querySelector<HTMLElement>("#hero-counter");
              const dataEl =
                container.querySelector('script[type="application/json"]#hero-photos') ||
                document.getElementById("hero-photos");

              let photos: any[] = [];
              try {
                if (dataEl) {
                  photos = JSON.parse((dataEl.textContent || "").trim());
                }
              } catch (error) {
                debug("[Hero] JSON parse error:", error);
              }

              if (!Array.isArray(photos) || photos.length === 0) {
                debug("[Hero] No valid photos array");
                return;
              }

              let currentIndex = normalizePhotoIndex(
                container.getAttribute("data-active-photo-index") ||
                  img.dataset.currentIndex ||
                  0,
                photos.length,
                0,
              );

              function updateHeroCounter(idx) {
                if (counterEl && photos.length > 1) {
                  counterEl.textContent = `${idx + 1} / ${photos.length}`;
                }
              }

              function updateHeroBackground(src) {
                if (src) {
                  heroContainer.style.setProperty("--hero-bg", `url("${src}")`);
                }
              }

              function applyPhoto(index, emitChange = true) {
                currentIndex = normalizePhotoIndex(index, photos.length, 0);
                const photo = photos[currentIndex];
                if (!photo) return;

                const src = photo.src;
                console.debug("[PHOTO-TRACE][Hero] applyPhoto", {
                  requestedIndex: index,
                  currentIndex,
                  src,
                });
                heroContainer.setAttribute("data-active-photo-src", src);
                heroImg.dataset.currentIndex = String(currentIndex);
                heroImg.src = src;
                heroImg.alt = photo.alt || photo.altText || "Hero image";
                updateHeroBackground(src);
                updateHeroCounter(currentIndex);
                heroContainer.setAttribute("data-active-photo-index", String(currentIndex));

                if (emitChange) {
                  document.dispatchEvent(
                    new CustomEvent(PHOTO_ACTIVE_INDEX_CHANGE_EVENT, {
                      detail: {
                        sourceView: "hero",
                        index: currentIndex,
                        src,
                      },
                    }),
                  );
                }
              }

              applyPhoto(currentIndex, false);

              heroImg.addEventListener("click", () => {
                const nextIndex = normalizePhotoIndex(currentIndex + 1, photos.length, 0);
                applyPhoto(nextIndex, true);
              });

              heroContainer.addEventListener("hero-update", (event) => {
                const detail = (event as CustomEvent).detail || {};
                if (Array.isArray(detail.photos) && detail.photos.length > 0) {
                  photos = detail.photos;
                }
                applyPhoto(detail.activeIndex ?? currentIndex, false);
              });

              heroContainer.dataset.heroInitialized = "1";
              debug("[Hero] Initialization complete");
            }

            if (document.readyState === "loading") {
              document.addEventListener("DOMContentLoaded", init);
            } else {
              init();
            }

            document.addEventListener("astro:after-swap", () => {
              init();
            });
          })();
        </script>
    </figure>
  ) : (
    <div>No photos available</div>
  )}
</div>

<style>
  .mdx-hero {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    margin: 0;
    padding: 0;
  }
  .hero-figure {
    position: relative;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    background: rgb(var(--color-fill));
    overflow: hidden;
  }

  .hero-figure::before {
    content: "";
    position: absolute;
    inset: -6%;
    background-image: var(--hero-bg);
    background-size: cover;
    background-position: center;
    filter: blur(22px) saturate(118%) brightness(0.74);
    transform: scale(1.08);
    opacity: 0.75;
    z-index: 0;
  }

  .hero-figure::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(6, 9, 16, 0.2),
      rgba(6, 9, 16, 0.42)
    );
    z-index: 0;
  }

  .hero-figure > * {
    position: relative;
    z-index: 1;
  }
  .hero-figure img {
    width: auto;
    height: 100%;
    max-width: 100%;
    object-fit: contain;
    display: block;
    background: transparent;
    transition:
      transform 0.32s cubic-bezier(0.34, 1.56, 0.64, 1),
      opacity 0.26s ease,
      filter 0.26s ease;
  }

  .hero-counter-pill {
    position: absolute;
    right: 0.8rem;
    top: 0.8rem;
    color: rgba(255, 255, 255, 0.88);
    font-size: 0.72rem;
    letter-spacing: 0.01em;
    font-weight: 600;
    background: rgba(0, 0, 0, 0.34);
    padding: 0.24rem 0.55rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    pointer-events: none;
    backdrop-filter: blur(10px) saturate(130%);
    -webkit-backdrop-filter: blur(10px) saturate(130%);
    white-space: nowrap;
    z-index: 3;
  }

  .hero-caption {
    position: absolute;
    top: 0.8rem;
    left: 50%;
    transform: translateX(-50%);
    margin: 0;
    padding: 0.32rem 0.7rem;
    border-radius: 9999px;
    border: 1px solid rgba(var(--color-border), 0.42);
    background: rgba(var(--color-card), 0.6);
    color: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(10px) saturate(126%);
    -webkit-backdrop-filter: blur(10px) saturate(126%);
    pointer-events: none;
    white-space: nowrap;
    max-width: calc(100% - 7.5rem);
    overflow: hidden;
    text-overflow: ellipsis;
    z-index: 3;
  }
  
  .hero-image:hover {
    transform: scale(1.02);
    filter: brightness(1.05) saturate(1.03);
  }
  
  .hero-image:active {
    transform: scale(0.985);
  }

  :global(.photo-layout.is-max-view) .hero-figure {
    border-radius: 0;
  }

  :global(.photo-layout.is-max-view) .hero-figure img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  @media (max-width: 768px) {
    .hero-counter-pill {
      right: 0.55rem;
      top: 0.55rem;
    }

    .hero-caption {
      top: 0.55rem;
      max-width: calc(100% - 6.25rem);
      text-overflow: ellipsis;
      overflow: hidden;
    }
  }
</style>