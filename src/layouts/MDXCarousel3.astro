---
const {
  photos = [],
  carouselId = `carousel-${Math.random().toString(36).slice(2, 8)}`,
  initialIndex = 0,
  initialPlaying = false,
} = Astro.props;
const initialPhotoIndex = Math.max(0, Math.trunc(Number(initialIndex) || 0));
const shouldAutoplay = Boolean(initialPlaying);
---

<section class="carousel-container" id={carouselId} data-active-photo-index={initialPhotoIndex} data-carousel-playing={shouldAutoplay ? "1" : "0"}>
  <div class="carousel-track" id={`${carouselId}-track`} style="-webkit-overflow-scrolling: touch;">
    {
      photos.map((photo, index) => (
        <div class="carousel-slide" data-src={photo.src}>
          <img
            src={photo.src}
            alt={photo.alt ?? `Photo ${index + 1}`}
            loading="lazy"
            decoding="async"
            class="clickable-image"
            draggable="false"
          />
        </div>
      ))
    }
  </div>

  <div class="controls">
    <button id={`${carouselId}-prevBtn`} aria-label="Previous">‹</button>
    <button id={`${carouselId}-toggleBtn`} aria-label="Play/Pause">⏸</button>
    <button id={`${carouselId}-nextBtn`} aria-label="Next">›</button>
  </div>

  <div id={`${carouselId}-counter`} class="carousel-counter">
    {photos.length > 0 ? `${initialPhotoIndex + 1} / ${photos.length}` : ""}
  </div>

  <div id={`${carouselId}-modal`} class="modal">
    <img id={`${carouselId}-modalImage`} src="" alt="Full view" draggable="false" />
  </div>

  <slot />

  <script>
    import {
      PHOTO_ACTIVE_INDEX_CHANGE_EVENT,
      normalizePhotoIndex,
    } from "../utils/photoViewState";

    (() => {
      function setupCarousel(container, forceReinit = false, forcedIndex = null) {
        if (!container) return;
        if (container.dataset.carouselInitialized === "1" && !forceReinit) return;

        const version = String(Number(container.dataset.carouselVersion || "0") + 1);
        container.dataset.carouselVersion = version;
        const isActiveInstance = () => container.dataset.carouselVersion === version;

        const id = container.id;
        const track = container.querySelector(".carousel-track") as unknown as HTMLElement | null;
        const slides = track
          ? (Array.from(track.querySelectorAll(".carousel-slide")) as unknown as HTMLElement[])
          : [];
        const modal = document.getElementById(id + "-modal");
        const modalImage = document.querySelector<HTMLImageElement>(`#${id}-modalImage`);
        const counterEl = document.getElementById(id + "-counter");

        if (!track || slides.length === 0) {
          container.dataset.carouselInitialized = "1";
          return;
        }

        const carouselTrack = track;

        let currentIndex = normalizePhotoIndex(
          forcedIndex ?? container.getAttribute("data-active-photo-index") ?? 0,
          slides.length,
          0,
        );
        let isPlaying = container.dataset.carouselPlaying === "1";
        let snapTimer;

        function clearAutoplayInterval() {
          const active = container.dataset.carouselInterval;
          if (active) {
            clearInterval(Number(active));
            delete container.dataset.carouselInterval;
          }
        }

        function getSlideWidth() {
          return carouselTrack.clientWidth || 0;
        }

        function updateCounter() {
          if (counterEl) counterEl.textContent = `${currentIndex + 1} / ${slides.length}`;
        }

        function updateActiveSource() {
          const slide = slides[currentIndex];
          const src = slide?.dataset.src || slide?.querySelector("img")?.getAttribute("src") || "";
          if (src) {
            container.dataset.activePhotoSrc = src;
          }
        }

        function goToSlide(idx, behavior = "smooth", emitChange = false) {
          if (!isActiveInstance()) return;
          currentIndex = normalizePhotoIndex(idx, slides.length, 0);
          const width = getSlideWidth();
          if (width > 0) {
            carouselTrack.scrollTo({ left: currentIndex * width, behavior: behavior as ScrollBehavior });
          }
          container.dataset.activePhotoIndex = String(currentIndex);
          updateActiveSource();
          console.debug("[PHOTO-TRACE][Carousel] goToSlide", {
            requestedIndex: idx,
            currentIndex,
            behavior,
            activePhotoSrc: container.dataset.activePhotoSrc,
          });
          updateCounter();

          if (emitChange) {
            document.dispatchEvent(
              new CustomEvent(PHOTO_ACTIVE_INDEX_CHANGE_EVENT, {
                detail: {
                  sourceView: "carousel",
                  index: currentIndex,
                  src: container.dataset.activePhotoSrc || "",
                },
              }),
            );
          }
        }

        function setPlaying(playing) {
          if (!isActiveInstance()) return;
          isPlaying = !!playing;
          container.dataset.carouselPlaying = isPlaying ? "1" : "0";
          const toggleBtn = document.getElementById(id + "-toggleBtn");
          if (toggleBtn) toggleBtn.textContent = isPlaying ? "⏸" : "▶";
          clearAutoplayInterval();
          if (isPlaying) {
            const intervalId = window.setInterval(() => {
              if (!isActiveInstance()) {
                clearInterval(intervalId);
                return;
              }
              goToSlide(currentIndex + 1, "smooth", true);
            }, 4000);
            container.dataset.carouselInterval = String(intervalId);
          }
        }

        function restartAutoplayTimer() {
          if (!isActiveInstance() || !isPlaying) return;
          clearAutoplayInterval();
          const intervalId = window.setInterval(() => {
            if (!isActiveInstance()) {
              clearInterval(intervalId);
              return;
            }
            goToSlide(currentIndex + 1, "smooth", true);
          }, 4000);
          container.dataset.carouselInterval = String(intervalId);
        }

        function openModal(src) {
          if (!isActiveInstance()) return;
          if (modal && modalImage && src) {
            modalImage.src = src;
            modal.style.display = "flex";
          }
        }

        function closeModal() {
          if (!isActiveInstance()) return;
          if (modal) {
            modal.style.display = "none";
            if (modalImage) modalImage.src = "";
          }
        }

        ["prevBtn", "nextBtn", "toggleBtn"].forEach((btnKey) => {
          const btn = document.getElementById(id + "-" + btnKey);
          if (btn) {
            const clone = btn.cloneNode(true);
            btn.parentNode?.replaceChild(clone, btn);
          }
        });

        document.getElementById(id + "-prevBtn")?.addEventListener("click", (event) => {
          event.preventDefault();
          goToSlide(currentIndex - 1, "smooth", true);
          restartAutoplayTimer();
        });
        document.getElementById(id + "-nextBtn")?.addEventListener("click", (event) => {
          event.preventDefault();
          goToSlide(currentIndex + 1, "smooth", true);
          restartAutoplayTimer();
        });
        document.getElementById(id + "-toggleBtn")?.addEventListener("click", (event) => {
          event.preventDefault();
          event.stopPropagation();
          setPlaying(!isPlaying);
        });

        slides.forEach((slide: HTMLElement, idx) => {
          const clone = slide.cloneNode(true) as unknown as HTMLElement;
          slide.parentNode?.replaceChild(clone, slide);
          slides[idx] = clone;
          clone.addEventListener("click", () => {
            const src = clone.dataset.src || clone.querySelector("img")?.src;
            openModal(src);
          });
        });

        modal?.addEventListener("click", closeModal);

        carouselTrack.addEventListener(
          "scroll",
          () => {
            if (!isActiveInstance()) return;
            clearTimeout(snapTimer);
            snapTimer = window.setTimeout(() => {
              if (!isActiveInstance()) return;
              const width = getSlideWidth();
              if (width > 0) {
                const idx = Math.round(track.scrollLeft / width);
                if (idx !== currentIndex) {
                  currentIndex = normalizePhotoIndex(idx, slides.length, 0);
                  container.dataset.activePhotoIndex = String(currentIndex);
                  updateActiveSource();
                  updateCounter();
                  document.dispatchEvent(
                    new CustomEvent(PHOTO_ACTIVE_INDEX_CHANGE_EVENT, {
                      detail: {
                        sourceView: "carousel",
                        index: currentIndex,
                        src: container.dataset.activePhotoSrc || "",
                      },
                    }),
                  );
                  restartAutoplayTimer();
                }
              }
            }, 60);
          },
          { passive: true },
        );

        clearAutoplayInterval();
        goToSlide(currentIndex, "auto", false);
        setPlaying(isPlaying);

        container.dataset.carouselInitialized = "1";
      }

      function initAll() {
        document.querySelectorAll<HTMLElement>(".carousel-container").forEach((container) => {
          setupCarousel(container, false);
        });
      }

      document.addEventListener("reinit-carousel", (event) => {
        const detail = (event as CustomEvent).detail || {};
        const container = detail.containerId ? document.getElementById(detail.containerId) : null;
        if (container) {
          if (detail.activeIndex != null) {
            container.setAttribute("data-active-photo-index", String(detail.activeIndex));
          }
          setupCarousel(container, true, detail.activeIndex);
        }
      });

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initAll);
      } else {
        initAll();
      }

      document.addEventListener("astro:after-swap", initAll);
    })();
  </script>

  <style>
    .carousel-container {
      position: relative;
      overflow: hidden;
      width: 100%;
      max-width: none;
      margin: auto;
      height: 100%;
      min-height: clamp(320px, 68vh, 920px);
      aspect-ratio: var(--carousel-aspect, 1 / 1);
      --controls-height: 52px;
      background:
        radial-gradient(
          130% 145% at 10% 6%,
          rgba(var(--color-accent), 0.16),
          rgba(var(--color-fill), 0.4) 42%,
          rgba(var(--color-fill), 0.92) 100%
        ),
        rgb(var(--color-fill));
      animation: carousel-enter 560ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
    }

    .carousel-track {
      display: flex;
      overflow-x: scroll;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      width: 100%;
      height: 100%;
    }

    .carousel-track::-webkit-scrollbar {
      display: none;
    }

    .carousel-slide {
      min-width: 100%;
      width: 100%;
      height: 100%;
      box-sizing: border-box;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      background: transparent;
      scroll-snap-align: center;
      flex-shrink: 0;
    }

    .controls {
      position: absolute;
      bottom: 0.5rem;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      gap: 0.6rem;
      z-index: 10;
      animation: controls-enter 360ms ease both;
    }

    .controls button {
      width: 2.5rem;
      height: 2.5rem;
      border-radius: 999px;
      border: 1px solid rgba(255, 255, 255, 0.18);
      background: rgba(255, 255, 255, 0.08);
      color: #fff;
      font-size: 1.05rem;
      cursor: pointer;
      backdrop-filter: blur(10px) saturate(120%);
      -webkit-backdrop-filter: blur(10px) saturate(120%);
      box-shadow: none;
    }

    .carousel-counter {
      position: absolute;
      top: 0.5rem;
      right: 0.5rem;
      z-index: 10;
      color: #fff;
      background: rgba(0, 0, 0, 0.52);
      border: 1px solid rgba(255, 255, 255, 0.16);
      border-radius: 999px;
      padding: 0.18rem 0.46rem;
      font-size: 0.72rem;
      backdrop-filter: blur(10px) saturate(120%);
      -webkit-backdrop-filter: blur(10px) saturate(120%);
    }

    .modal {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.92);
      display: none;
      justify-content: center;
      align-items: center;
      z-index: 1000;
    }

    .modal img {
      max-width: 90%;
      max-height: 90%;
      border-radius: 8px;
      transition: transform 0.3s ease;
    }

    :global(.photo-layout.is-max-view) .carousel-container {
      min-height: 100%;
      border-radius: 0;
    }

    :global(.photo-layout.is-max-view) .carousel-slide img.clickable-image {
      padding: 0 0 2rem;
    }

    @keyframes carousel-enter {
      from {
        opacity: 0;
        transform: translateY(10px) scale(0.988);
      }
      to {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }

    @keyframes controls-enter {
      from {
        opacity: 0;
        transform: translateY(8px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .carousel-container,
      .controls,
      .carousel-counter {
        animation: none;
      }
    }
  </style>
</section>
