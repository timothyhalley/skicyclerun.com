---
import { Image } from "astro:assets";
import { SkiCycleRunConfig } from "../skicyclerun.config";
import MDXCarousel3 from "./MDXCarousel3.astro";
import MDXHeroView from "./MDXHeroView.astro";
import MDXGalleryView from "./MDXGalleryView.astro";
import FullViewTopBar from "@components/FullViewTopBar.astro";
import { getPhotoByName } from "../utils/getPhotoCover";
import { normalizePhotoIndex, parseRequestedPhotoIndex } from "../utils/photoViewState";
import expandIcon from "../assets/svg_imgs/expand.svg";
import phoneRotateArrowIcon from "../assets/svg_imgs/phone-rotate-arrow.svg";
import phoneRotateOrientationIcon from "../assets/svg_imgs/phone-rotate-orientation.svg";

const { frontmatter } = Astro.props;
const album = frontmatter?.album;
const travelMap = getPhotoByName(frontmatter?.travelmap ?? null);
const fullViewTitleLabel =
  Astro.url.pathname.split("/").filter(Boolean).at(-1) ||
  `${frontmatter?.title || ""}`;
const initialPhotoIndex = parseRequestedPhotoIndex(
  Astro.url.searchParams.get("index"),
);
const initialPhotoSrc = `${Astro.url.searchParams.get("src") || ""}`;
const dynamicPhotoLimit = SkiCycleRunConfig.photoApi.dynamicPhotos;
const buildTimePhotoLimit = SkiCycleRunConfig.photoApi.buildTimePhotos;
if (!album) throw new Error("PhotoLayout requires frontmatter.album to be set");
const BOOTSTRAP_IMG =
  "data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==";
const photos: any[] = [
  {
    src: BOOTSTRAP_IMG,
    altText: "Loading photos",
    alt: "Loading photos",
    sourceType: "local",
  },
];
---

<article
  class="photo-layout"
  data-album={album}
  data-dynamic-photo-limit={dynamicPhotoLimit}
  data-build-photo-limit={buildTimePhotoLimit}
  data-title={frontmatter?.title || ""}
  data-description={frontmatter?.description || ""}
  data-travel-map={frontmatter?.travelmap || ""}
  data-active-photo-index={initialPhotoIndex}
  data-active-photo-src={initialPhotoSrc}
  style={`--rotate-icon-arrow: url('${phoneRotateArrowIcon.src}'); --rotate-icon-orientation: url('${phoneRotateOrientationIcon.src}');`}
>
  <FullViewTopBar
    brandLabel="SkiCycleRun"
    sectionLabel="Posts"
    titleLabel={fullViewTitleLabel}
    homeHref="/posts"
  />

  <header class="photo-layout-header mb-2">
    {
      frontmatter.title && (
        <h1 class="text-3xl font-bold">{frontmatter.title}</h1>
      )
    }
    {
      frontmatter.description && (
        <p class="text-skin-muted mt-2">{frontmatter.description}</p>
      )
    }
  </header>

  <div class="photo-controls-wrap not-prose relative mb-0">
    <!-- Click hint tooltip - positioned on same line as radio controls, centered -->
    <div
      id="click-hint"
      class="absolute top-1/2 -translate-y-1/2 left-1/2 -translate-x-1/2 transition-opacity duration-500 animate-bounce"
      style="z-index: 30; pointer-events: none;"
    >
      <div class="click-hint-pill">👇 Tap photo</div>
    </div>

    <!-- Full-screen hint - appears after tap hint fades, above and right of expand button -->
    <div
      id="fullscreen-hint"
      class="absolute right-6 transition-opacity duration-500 animate-bounce"
      style="z-index: 30; pointer-events: none; opacity: 0; bottom: calc(100% + 0.35rem);"
    >
      <div class="click-hint-pill">Full screen 👇</div>
    </div>

    <nav
      class="photo-view-nav w-full flex justify-end pr-6"
      aria-label="Photo view selector"
    >
      <div class="photo-view-nav-group inline-flex items-center gap-4 whitespace-nowrap ml-auto">
        <label class="cursor-pointer">
          <input type="radio" name="photo-view" value="hero" checked /> Single
        </label>
        <label class="cursor-pointer">
          <input type="radio" name="photo-view" value="gallery" /> Gallery
        </label>
        <label class="cursor-pointer">
          <input type="radio" name="photo-view" value="carousel" /> Carousel
        </label>
        <button
          type="button"
          id="open-full-view"
          class="open-full-view"
          aria-label="Open full view"
          title="Open full view"
        >
          <img src={expandIcon.src} alt="" class="icon-btn" />
        </button>
      </div>
    </nav>
  </div>

  <div class="photo-stage not-prose relative">
    <section class="photo-view relative">
      <div id="photo-hero">
        <MDXHeroView
          photos={photos}
          frontmatter={frontmatter}
          initialIndex={initialPhotoIndex}
        />
      </div>
      <div id="photo-gallery" style="display:none">
        <MDXGalleryView
          photos={photos}
          frontmatter={frontmatter}
          initialIndex={initialPhotoIndex}
        />
      </div>
      <div id="photo-carousel" style="display:none">
        <MDXCarousel3
          photos={photos}
          initialIndex={initialPhotoIndex}
          initialPlaying={false}
        />
      </div>
    </section>

    <div id="photo-active-counter" class="photo-active-counter" aria-live="polite">
      1 / 1
    </div>
  </div>

  <div
    class="photo-style-controls not-prose mt-4 flex flex-wrap items-center justify-center gap-3"
  >
    <label for="lora-style" class="font-medium">Style:</label>
    <select
      id="lora-style"
      class="px-3 py-1.5 rounded border border-skin-line bg-skin-fill text-skin-base cursor-pointer"
    >
      <option value="random" selected>Random Mix</option>
      <option value="purus">Pūrus</option>
      <option value="Afremov">Afremov</option>
      <option value="Gorillaz">Gorillaz</option>
      <option value="Origami">Origami</option>
      <option value="PencilDrawing">Pencil Drawing</option>
      <option value="FractalGeometry">Fractal Geometry</option>
    </select>
    <span class="text-skin-muted">·</span>
    <label class="cursor-pointer flex items-center gap-2">
      <input type="checkbox" id="use-dynamic" class="cursor-pointer" />
      <span class="font-medium"
        >Full Album <span class="text-skin-muted italic">(slower)</span></span
      >
    </label>
  </div>

  <div id="dynamic-loading" style="display:none" class="dynamic-loading">
    <p>Loading full image library from API...</p>
    <div class="spinner"></div>
  </div>

  <!-- Render page MDX content inside the master layout -->
  <slot />

  {
    travelMap && (
      <figure class="travel-map-wrap">
        <Image
          src={travelMap}
          alt={`${frontmatter?.title || "Travel"} map`}
          widths={[800, 1200, 1600]}
          sizes="(max-width: 1024px) 100vw, 1024px"
          format="webp"
          quality={80}
          loading="lazy"
          class="travel-map-image"
        />
      </figure>
    )
  }

  <script>
    import {
      PHOTO_ACTIVE_INDEX_CHANGE_EVENT,
      normalizePhotoIndex,
    } from "../utils/photoViewState";
    import {
      resolveInitialPhotoView,
      resolveInitialPhotoState,
      setActivePhotoState,
      setPhotoViewState,
    } from "../state/photoState";

    document.addEventListener("DOMContentLoaded", function () {
      const debugEnabled = import.meta.env.PUBLIC_DEBUG_OUTPUT === "true";
      const debugLog = (...args) => {
        if (debugEnabled) console.log("[DEBUG][UI]", ...args);
      };
      const debugWarn = (...args) => {
        if (debugEnabled) console.warn("[DEBUG][WARN]", ...args);
      };
      const debugError = (...args) => {
        if (debugEnabled) console.error("[DEBUG][ERROR]", ...args);
      };

      const radios = Array.from(
        document.querySelectorAll('input[name="photo-view"]'),
      );
      const dynamicCheckbox = document.getElementById(
        "use-dynamic",
      ) as HTMLInputElement | null;
      const loraSelect = document.getElementById(
        "lora-style",
      ) as HTMLSelectElement | null;
      const album = document
        .querySelector(".photo-layout")
        ?.getAttribute("data-album");
      const dynamicPhotoLimit = Number(
        document
          .querySelector(".photo-layout")
          ?.getAttribute("data-dynamic-photo-limit") || "250",
      );
      const buildTimePhotoLimit = Number(
        document
          .querySelector(".photo-layout")
          ?.getAttribute("data-build-photo-limit") || "32",
      );
      const loadingEl = document.getElementById("dynamic-loading");
      const clickHint = document.getElementById("click-hint");
      const fullscreenHint = document.getElementById("fullscreen-hint");
      const openFullViewBtn = document.getElementById("open-full-view");
      const exitFullPageBtn = document.getElementById("exit-full-page");
      const fullViewBrandLink = document.getElementById("full-view-brand-link");
      const photoActiveCounter = document.getElementById("photo-active-counter");
      const fullViewTopCounter = document.getElementById("full-view-top-counter");
      const layoutRoot = document.querySelector(".photo-layout");
      const photoStage = document.querySelector(".photo-stage") as HTMLElement | null;

      // ── Shared state store ────────────────────────────────────────────────────
      // resolveInitialPhotoState() checks URL params first (explicit handoff),
      // then the sessionStorage entry written by the previous mode, then 0/""
      // as defaults. This is immune to SSR normalisation issues because we never
      // read the data-active-photo-index attribute that SSR set against a 1-photo
      // bootstrap placeholder array.
      const _initialState = resolveInitialPhotoState(album || "");
      let activePhotoIndex: number = _initialState.index;
      let activePhotoSrc: string = _initialState.src;
      // Persist immediately so both modes always see the latest state.
      if (album) setActivePhotoState(album, activePhotoIndex, activePhotoSrc);

      let activePhotoCount = 0;

      const sections = {
        hero: document.getElementById("photo-hero"),
        gallery: document.getElementById("photo-gallery"),
        carousel: document.getElementById("photo-carousel"),
      };

      const currentUrl = new URL(window.location.href);
      const isFullPageMode = currentUrl.searchParams.get("full") === "1";
      const initialView = currentUrl.searchParams.get("view");
      const initialStyle = currentUrl.searchParams.get("style");
      const initialDynamic = currentUrl.searchParams.get("dynamic") === "1";
      const selectedInitialView = resolveInitialPhotoView(album || "", initialView);
      let rotateHintRaf = 0;

      function getCurrentFullViewType(): "hero" | "gallery" | "carousel" {
        const checked = document.querySelector(
          'input[name="photo-view"]:checked',
        ) as HTMLInputElement | null;
        return checked?.value === "gallery" || checked?.value === "carousel"
          ? checked.value
          : "hero";
      }

      function getCurrentFullViewImageElement(): HTMLImageElement | null {
        const view = getCurrentFullViewType();
        if (view === "hero") {
          return sections.hero?.querySelector(
            ".hero-figure img",
          ) as HTMLImageElement | null;
        }

        if (view === "carousel") {
          const carouselRoot = sections.carousel?.querySelector(".carousel-container");
          return (
            carouselRoot?.querySelector(
              'img[data-current-index]',
            ) as HTMLImageElement | null
          ) ||
            (carouselRoot?.querySelector(
              ".carousel-slide img.clickable-image",
            ) as HTMLImageElement | null);
        }

        return null;
      }

      function updateRotateHintVisibility() {
        if (!isFullPageMode || !layoutRoot || !photoStage) {
          layoutRoot?.classList.remove("show-rotate-hint");
          return;
        }

        const currentView = getCurrentFullViewType();
        if (currentView === "gallery") {
          layoutRoot.classList.remove("show-rotate-hint");
          return;
        }

        const img = getCurrentFullViewImageElement();
        if (!img || !img.complete || img.naturalWidth <= 0 || img.naturalHeight <= 0) {
          layoutRoot.classList.remove("show-rotate-hint");
          return;
        }

        const stageWidth = photoStage.clientWidth;
        const stageHeight = photoStage.clientHeight;
        if (stageWidth <= 0 || stageHeight <= 0) {
          layoutRoot.classList.remove("show-rotate-hint");
          return;
        }

        const scale = Math.min(
          stageWidth / img.naturalWidth,
          stageHeight / img.naturalHeight,
        );
        const renderedWidth = img.naturalWidth * scale;
        const renderedHeight = img.naturalHeight * scale;
        const sideGap = Math.max(0, (stageWidth - renderedWidth) / 2);
        const topBottomGap = Math.max(0, (stageHeight - renderedHeight) / 2);
        const naturalAspect = img.naturalWidth / img.naturalHeight;

        // Suppress hints for extreme-axis images (e.g. panoramas / tall strips).
        // In these cases gutters are expected and rotating usually won't improve fit.
        const isExtremeAxisImage = naturalAspect >= 2.15 || naturalAspect <= 0.46;

        // Match CSS clamp(48px, 11.6vw, 72px) used for hint icon size.
        const hintIconSizePx = Math.min(
          Math.max(window.innerWidth * 0.116, 48),
          72,
        );
        // To keep the icon fully inside gutter when centered, the gutter must
        // be at least icon size (plus a tiny buffer).
        const requiredGutterPx = hintIconSizePx + 4;

        // Keep hint anchors centered within the non-photo gutter regions.
        layoutRoot.style.setProperty(
          "--rotate-hint-left-x",
          `${Math.max(12, sideGap / 2)}px`,
        );
        layoutRoot.style.setProperty(
          "--rotate-hint-right-x",
          `${Math.min(stageWidth - 12, stageWidth - sideGap / 2)}px`,
        );
        layoutRoot.style.setProperty(
          "--rotate-hint-top-y",
          `${Math.max(12, topBottomGap / 2)}px`,
        );
        layoutRoot.style.setProperty(
          "--rotate-hint-bottom-y",
          `${Math.min(stageHeight - 12, stageHeight - topBottomGap / 2)}px`,
        );

        // Geometry-driven display: show only when there is enough real gutter
        // area so hints remain in the gray margins and never overlay the photo.
        const hasSideGutters = sideGap >= requiredGutterPx;
        const hasTopBottomGutters = topBottomGap >= requiredGutterPx;
        const showHint = !isExtremeAxisImage && (hasSideGutters || hasTopBottomGutters);

        layoutRoot.classList.toggle("show-rotate-hint", showHint);
        layoutRoot.classList.toggle("show-rotate-hint-side", showHint && hasSideGutters);
        layoutRoot.classList.toggle(
          "show-rotate-hint-topbottom",
          showHint && !hasSideGutters && hasTopBottomGutters,
        );
      }

      function scheduleRotateHintVisibility() {
        if (!isFullPageMode) return;
        if (rotateHintRaf) {
          window.cancelAnimationFrame(rotateHintRaf);
        }
        rotateHintRaf = window.requestAnimationFrame(() => {
          rotateHintRaf = 0;
          updateRotateHintVisibility();
        });
      }

      function syncFullModePhotoState() {
        if (!isFullPageMode) return;

        const checked = document.querySelector(
          'input[name="photo-view"]:checked',
        ) as HTMLInputElement | null;
        const view =
          checked?.value === "gallery" || checked?.value === "carousel"
            ? checked.value
            : "hero";
        if (album) setPhotoViewState(album, view);
        const normalizedIndex = Math.max(0, Math.trunc(activePhotoIndex));
        const currentPhotoSrc = activePhotoSrc;

        const next = new URL(window.location.href);
        next.searchParams.set("full", "1");
        next.searchParams.set("view", view);
        next.searchParams.set("style", loraSelect?.value || "random");
        next.searchParams.set("dynamic", dynamicCheckbox?.checked ? "1" : "0");
        next.searchParams.set("index", String(normalizedIndex));
        if (currentPhotoSrc) {
          next.searchParams.set("src", currentPhotoSrc);
        }
        window.history.replaceState({}, "", next.toString());
      }

      function updateActiveCounter() {
        if (!photoActiveCounter) return;
        const total = Math.max(0, activePhotoCount);
        if (total <= 0) {
          photoActiveCounter.textContent = "0 / 0";
          return;
        }
        const current = normalizePhotoIndex(activePhotoIndex, total, 0) + 1;
        const counter = `${current} / ${total}`;
        photoActiveCounter.textContent = counter;
        if (fullViewTopCounter) {
          fullViewTopCounter.textContent = counter;
        }
        console.debug("[PHOTO-TRACE][PhotoLayout] counter", {
          counter,
          activePhotoIndex,
          activePhotoCount: total,
          activePhotoSrc: layoutRoot?.getAttribute("data-active-photo-src") || "",
        });
      }

      function exitFullPageMode() {
        const next = new URL(window.location.href);
        const checked = document.querySelector(
          'input[name="photo-view"]:checked',
        ) as HTMLInputElement | null;
        const view =
          checked?.value === "gallery" || checked?.value === "carousel"
            ? checked.value
            : "hero";
        if (album) setPhotoViewState(album, view);

        next.searchParams.delete("full");
        window.location.assign(next.toString());
      }

      const radio = document.querySelector(
        `input[name="photo-view"][value="${selectedInitialView}"]`,
      ) as HTMLInputElement | null;
      if (radio) radio.checked = true;
      if (album) setPhotoViewState(album, selectedInitialView);
      if (loraSelect && initialStyle) {
        loraSelect.value = initialStyle;
      }

      // Always start with fast initial mode unless query explicitly restores dynamic mode.
      if (dynamicCheckbox) {
        dynamicCheckbox.checked = isFullPageMode ? initialDynamic : false;
      }

      if (isFullPageMode) {
        layoutRoot?.classList.add("is-full-page-mode");
        document.body.classList.add("photo-full-page-active");

        // Keep URL index/src in sync while full mode is active so exiting returns
        // to the exact same image in normal mode (1:1 handoff).
        const syncOnInteraction = () => {
          window.setTimeout(syncFullModePhotoState, 0);
          window.setTimeout(syncFullModePhotoState, 220);
          window.setTimeout(scheduleRotateHintVisibility, 0);
          window.setTimeout(scheduleRotateHintVisibility, 220);
        };

        sections.hero
          ?.querySelector("img")
          ?.addEventListener("click", syncOnInteraction);
        sections.gallery
          ?.querySelector(".mdx-gallery")
          ?.addEventListener("click", syncOnInteraction);
        sections.carousel
          ?.querySelector(".carousel-container")
          ?.addEventListener("click", syncOnInteraction);
        radios.forEach((r) => r.addEventListener("change", syncOnInteraction));
        dynamicCheckbox?.addEventListener("change", syncOnInteraction);
        loraSelect?.addEventListener("change", syncOnInteraction);

        window.addEventListener("resize", scheduleRotateHintVisibility);
        window.addEventListener("orientationchange", scheduleRotateHintVisibility);
        scheduleRotateHintVisibility();

      }

      // Show the selector hint only once on initial load, then hide after 2 seconds.
      if (clickHint) {
        setTimeout(() => {
          clickHint.style.opacity = "0";
          setTimeout(() => {
            clickHint.style.display = "none";
            // Show fullscreen hint right after tap hint fully fades
            if (fullscreenHint) {
              fullscreenHint.style.opacity = "1";
              setTimeout(() => {
                fullscreenHint.style.opacity = "0";
                setTimeout(() => {
                  fullscreenHint.style.display = "none";
                }, 500);
              }, 2000);
            }
          }, 500);
        }, 2000);
      }

      let dynamicPhotosLoaded = false;
      let dynamicPhotos: any[] = [];
      let dynamicPhotosFullSet: any[] = [];
      let staticPhotos: any[] = []; // Store original static photos
      let currentPhotos: any[] = [];

      function syncViewsToActiveState(sourceView = "") {
        if (!Array.isArray(currentPhotos) || currentPhotos.length === 0) return;

        activePhotoIndex = normalizePhotoIndex(activePhotoIndex, currentPhotos.length, 0);
        const activePhoto = currentPhotos[activePhotoIndex] || null;

        if (activePhoto?.src) {
          activePhotoSrc = activePhoto.src;
        }

        layoutRoot?.setAttribute("data-active-photo-index", String(activePhotoIndex));
        if (activePhotoSrc) {
          layoutRoot?.setAttribute("data-active-photo-src", activePhotoSrc);
        }
        if (album) setActivePhotoState(album, activePhotoIndex, activePhotoSrc);

        if (sourceView !== "hero") {
          const heroFigure = sections.hero?.querySelector("figure[data-photos-json]");
          heroFigure?.dispatchEvent(
            new CustomEvent("hero-update", {
              detail: { photos: currentPhotos, activeIndex: activePhotoIndex },
            }),
          );
        }

        if (sourceView !== "gallery") {
          const galleryDiv = sections.gallery?.querySelector(".mdx-gallery");
          galleryDiv?.dispatchEvent(
            new CustomEvent("gallery-update", {
              detail: { photos: currentPhotos, activeIndex: activePhotoIndex },
              bubbles: false,
            }),
          );
        }

        const carouselRoot = sections.carousel?.querySelector(
          ".carousel-container",
        ) as HTMLElement | null;
        if (carouselRoot) {
          carouselRoot.setAttribute("data-active-photo-index", String(activePhotoIndex));
          if (activePhoto?.src) {
            carouselRoot.setAttribute("data-active-photo-src", activePhoto.src);
          }
        }

        updateActiveCounter();
        scheduleRotateHintVisibility();
      }

      function openDedicatedFullView() {
        if (isFullPageMode) {
          exitFullPageMode();
          return;
        }

        // Derive src from the authoritative currentPhotos array first; only fall
        // back to DOM if we somehow don't have photos loaded yet.
        const handoffIndex = activePhotoIndex;
        let handoffSrc = (Array.isArray(currentPhotos) && currentPhotos[handoffIndex]?.src)
          ? currentPhotos[handoffIndex].src
          : activePhotoSrc;

        // Last-chance DOM read if closure src is still empty/GIF.
        if (!handoffSrc || handoffSrc.startsWith("data:image/gif")) {
          const checked = document.querySelector('input[name="photo-view"]:checked') as HTMLInputElement | null;
          const view = checked?.value || "hero";
          const activeViewRoot = sections[view as keyof typeof sections];
          handoffSrc =
            activeViewRoot?.querySelector("[data-active-photo-src]")?.getAttribute("data-active-photo-src") ||
            activeViewRoot?.querySelector("img[data-current-index]")?.getAttribute("src") ||
            "";
        }

        const checked = document.querySelector(
          'input[name="photo-view"]:checked',
        ) as HTMLInputElement | null;
        const view =
          checked?.value === "gallery" || checked?.value === "carousel"
            ? checked.value
            : "hero";
        if (album) setPhotoViewState(album, view);
        const style = loraSelect?.value || "random";
        const dynamic = dynamicCheckbox?.checked ? "1" : "0";

        console.debug("[PHOTO-TRACE][PhotoLayout] fullscreen handoff", {
          view,
          handoffIndex,
          handoffSrc,
          activePhotoIndex,
          activePhotoSrc,
        });

        const params = new URLSearchParams();
        params.set("full", "1");
        params.set("view", view);
        params.set("style", style);
        params.set("dynamic", dynamic);
        params.set("index", String(handoffIndex));
        if (handoffSrc) {
          params.set("src", handoffSrc);
        }

        const fullViewUrl = new URL(window.location.href);
        fullViewUrl.search = params.toString();
        window.location.assign(fullViewUrl.toString());
      }

      openFullViewBtn?.addEventListener("click", openDedicatedFullView);
      exitFullPageBtn?.addEventListener("click", (event) => {
        event.preventDefault();
        event.stopPropagation();
        exitFullPageMode();
      });
      fullViewBrandLink?.addEventListener("click", (event) => {
        event.preventDefault();
        event.stopPropagation();
        exitFullPageMode();
      });

      // Get initial static photos from the page (try all views)
      function getStaticPhotos() {
        // Try hero view first
        for (const [viewName, viewDiv] of Object.entries(sections)) {
          if (viewDiv) {
            const scriptTag = viewDiv.querySelector(
              'script[type="application/json"]',
            );
            if (scriptTag) {
              try {
                const photos = JSON.parse(scriptTag.textContent || "[]");
                if (photos.length > 0) {
                  debugLog(
                    `[PhotoLayout] Found ${photos.length} static photos in ${viewName} view`,
                  );
                  return photos;
                }
              } catch (e) {
                debugWarn(
                  `[PhotoLayout] Failed to parse static photos from ${viewName}:`,
                  e,
                );
              }
            }
          }
        }
        debugWarn("[PhotoLayout] No static photos found in any view");
        return [];
      }

      function normalizePhotoSource(src) {
        if (!src) return "";
        try {
          const parsed = new URL(src, window.location.href);
          return `${parsed.origin}${parsed.pathname}`;
        } catch {
          return `${src}`.split("?")[0].split("#")[0];
        }
      }

      function findPhotoIndexBySource(photos, source) {
        const target = normalizePhotoSource(source);
        if (!target) return -1;
        return photos.findIndex(
          (photo) => normalizePhotoSource(photo?.src) === target,
        );
      }

      function getPhotoArrayCacheKey(style, useDynamic) {
        return [
          "photo-array-cache-v1",
          album || "",
          useDynamic ? "dynamic" : "static",
          style || "random",
          useDynamic ? String(dynamicPhotoLimit) : String(buildTimePhotoLimit),
        ].join(":");
      }

      function readPhotoArrayCache(style, useDynamic) {
        try {
          const key = getPhotoArrayCacheKey(style, useDynamic);
          const raw = window.sessionStorage.getItem(key);
          if (!raw) return [];
          const parsed = JSON.parse(raw);
          const photos = Array.isArray(parsed?.photos) ? parsed.photos : [];
          const normalized = photos.filter(
            (photo) => photo && typeof photo.src === "string" && !photo.src.startsWith("data:image/gif"),
          );
          return normalized;
        } catch {
          return [];
        }
      }

      function writePhotoArrayCache(style, useDynamic, photos) {
        if (!Array.isArray(photos) || photos.length === 0) return;
        try {
          const key = getPhotoArrayCacheKey(style, useDynamic);
          window.sessionStorage.setItem(
            key,
            JSON.stringify({
              photos,
              savedAt: Date.now(),
            }),
          );
        } catch {
          // Ignore storage quota/browser privacy mode failures.
        }
      }

      // Filter static photos by art style
      function filterStaticPhotosByStyle(photos, style) {
        debugLog(
          `[PhotoLayout] filterStaticPhotosByStyle called with ${photos.length} photos, style: ${style}`,
        );

        if (style === "random" || !style) {
          debugLog("[PhotoLayout] No filtering - showing all photos (random)");
          return photos;
        }

        // pūrus = photos tagged NoLoRA in the filename
        if (style === "purus") {
          const filtered = photos.filter((photo) => {
            let loraStyle = photo.loraStyle || photo.lora_style || photo.LoraStyle || photo.style;
            if (!loraStyle && photo.src) {
              const filename = photo.src.split("/").pop();
              const match = filename.match(/_([A-Za-z]+)_\d+\./);
              if (match && match[1]) loraStyle = match[1];
            }
            return loraStyle === "NoLoRA";
          });
          if (filtered.length === 0) {
            debugWarn(`[PhotoLayout] No pūrus (NoLoRA) photos found, returning all`);
            return photos;
          }
          return filtered;
        }

        const filtered = photos.filter((photo) => {
          // First check for explicit loraStyle property
          let loraStyle =
            photo.loraStyle ||
            photo.lora_style ||
            photo.LoraStyle ||
            photo.style;

          // If no property, extract from filename
          // Format: IMG_####_StyleName_########.webp
          if (!loraStyle && photo.src) {
            const filename = photo.src.split("/").pop(); // Get filename
            const match = filename.match(/_([A-Za-z]+)_\d+\./); // Match _StyleName_digits.
            if (match && match[1]) {
              loraStyle = match[1];
            }
          }

          const matches = loraStyle === style;
          debugLog(
            `[PhotoLayout] Photo: ${photo.src.split("/").pop()}, extracted style: ${loraStyle}, matches ${style}: ${matches}`,
          );
          return matches;
        });

        debugLog(
          `[PhotoLayout] Filtered ${photos.length} photos to ${filtered.length} for style: ${style}`,
        );

        // If filtering resulted in no photos, return all photos instead of empty array
        if (filtered.length === 0) {
          debugWarn(
            `[PhotoLayout] No photos match style "${style}", returning all photos instead`,
          );
          return photos;
        }

        return filtered;
      }

      function parseApiPhotoArray(payload) {
        if (Array.isArray(payload)) return payload;
        if (payload && Array.isArray(payload.photos)) return payload.photos;
        if (payload && Array.isArray(payload.data)) return payload.data;
        if (payload && Array.isArray(payload.items)) return payload.items;
        return [];
      }

      function buildAlbumCandidates(rawAlbum) {
        const base = `${rawAlbum || ""}`.trim();
        if (!base) return [];

        const camelToDash = base.replace(/([a-z0-9])([A-Z])/g, "$1-$2");
        const dashToCamel = base.replace(/-([a-zA-Z0-9])/g, (_, c) =>
          `${c}`.toUpperCase(),
        );

        const candidates = [
          base,
          base.toLowerCase(),
          base.replace(/\s+/g, "-"),
          base.replace(/\s+/g, ""),
          camelToDash,
          camelToDash.toLowerCase(),
          dashToCamel,
          dashToCamel.toLowerCase(),
        ];

        return [...new Set(candidates.filter(Boolean))];
      }

      async function sortPhotosByOrientation(photos) {
        debugLog(`[PhotoLayout] Sorting ${photos.length} photos by orientation...`);

        // Get dimensions for each photo — use S3 metadata when available, else load the image
        const photosWithAspect = await Promise.all(
          photos.map((photo) => {
            if (photo.width && photo.height && photo.width > 0 && photo.height > 0) {
              return Promise.resolve({ ...photo, aspect: photo.width / photo.height });
            }
            return new Promise((resolve) => {
              const img = new Image();
              img.onload = () => {
                const aspect = img.naturalWidth / img.naturalHeight;
                resolve({ ...photo, aspect });
              };
              img.onerror = () => {
                // If image fails to load, assume square (1:1)
                resolve({ ...photo, aspect: 1 });
              };
              img.src = photo.src;
            });
          })
        );

        // Use buckets to keep orientation flow visually consistent across runs.
        const LANDSCAPE_MIN = 1.05;
        const PORTRAIT_MAX = 0.95;

        const sorted = photosWithAspect.sort((a, b) => {
          const getBucket = (aspect) => {
            if (aspect >= LANDSCAPE_MIN) return 0;
            if (aspect <= PORTRAIT_MAX) return 2;
            return 1;
          };

          const aBucket = getBucket(a.aspect);
          const bBucket = getBucket(b.aspect);

          if (aBucket !== bBucket) return aBucket - bBucket;

          // Bucket 0: landscape, widest first.
          if (aBucket === 0) {
            if (a.aspect !== b.aspect) return b.aspect - a.aspect;
          }

          // Bucket 1: near-square, closer to 1:1 first.
          if (aBucket === 1) {
            const aDelta = Math.abs(a.aspect - 1);
            const bDelta = Math.abs(b.aspect - 1);
            if (aDelta !== bDelta) return aDelta - bDelta;
          }

          // Bucket 2: portrait, tallest first.
          if (aBucket === 2) {
            if (a.aspect !== b.aspect) return a.aspect - b.aspect;
          }

          // Stable deterministic tie-breaker.
          return `${a.src || ""}`.localeCompare(`${b.src || ""}`);
        });

        debugLog(`[PhotoLayout] Sorted photos by orientation: ${sorted.map(p => p.aspect.toFixed(2)).join(", ")}`);
        
        // Remove the aspect property before returning
        return sorted.map(({ aspect, ...photo }) => photo);
      }

      async function loadDynamicPhotos(loraStyle = "random") {
        if (dynamicPhotosLoaded && dynamicPhotosFullSet.length > 0) {
          dynamicPhotos = filterStaticPhotosByStyle(
            dynamicPhotosFullSet,
            loraStyle,
          );
          debugLog(
            `[PhotoLayout] Using cached dynamic photos for style: ${loraStyle}`,
          );
          return dynamicPhotos;
        }

        const stored = readPhotoArrayCache(loraStyle, true);
        if (stored.length > 0) {
          dynamicPhotos = stored;
          activePhotoCount = dynamicPhotos.length;
          debugLog(
            `[PhotoLayout] Using persisted dynamic photo array (${dynamicPhotos.length}) for style: ${loraStyle}`,
          );
          return dynamicPhotos;
        }

        if (!album) return [];

        try {
          if (loadingEl) loadingEl.style.display = "flex";

          const baseUrl =
            (window as typeof window & { PUBLIC_SKICYCLERUN_API?: string })
              .PUBLIC_SKICYCLERUN_API || "https://api.skicyclerun.com/v2/";
          const candidates = buildAlbumCandidates(album);
          let photoArray: any[] = [];
          let usedAlbum = "";

          for (const candidate of candidates) {
            // Full library mode must use the full album endpoint.
            const photoURL = `${baseUrl}getphotos?album=${encodeURIComponent(candidate)}`;
            debugLog(
              `[PhotoLayout] Fetching full library from API: ${photoURL}`,
            );

            const res = await fetch(photoURL);
            const data = await res.json();
            const parsed = parseApiPhotoArray(data);

            if (parsed.length > 0) {
              photoArray = parsed;
              usedAlbum = candidate;
              break;
            }
          }

          // Backward-compatible fallback for environments that do not expose getphotos.
          if (photoArray.length === 0) {
            for (const candidate of candidates) {
              const fallbackURL = `${baseUrl}getphotosrandom?bucketName=skicyclerun.lib&albumPath=albums/${encodeURIComponent(candidate)}/&numPhotos=${dynamicPhotoLimit}`;
              debugWarn(
                `[PhotoLayout] Full-library endpoint returned empty, trying fallback: ${fallbackURL}`,
              );
              const res = await fetch(fallbackURL);
              const data = await res.json();
              const parsed = parseApiPhotoArray(data);
              if (parsed.length > 0) {
                photoArray = parsed;
                usedAlbum = candidate;
                break;
              }
            }
          }

          if (photoArray.length > 0) {
            const normalized = photoArray
              .map((p, i) => {
                const src =
                  typeof p === "string"
                    ? p
                    : p?.src || p?.url || p?.image || p?.imageUrl;
                if (!src) return null;
                const w = p?.width != null ? parseInt(String(p.width), 10) : undefined;
                const h = p?.height != null ? parseInt(String(p.height), 10) : undefined;
                return {
                  src,
                  altText: p?.altText || `Photo ${i + 1}`,
                  alt: p?.alt,
                  loraStyle: p?.loraStyle || p?.lora_style || p?.style,
                  sourceType: "remote",
                  width: w && w > 0 ? w : undefined,
                  height: h && h > 0 ? h : undefined,
                };
              })
              .filter(Boolean);

            dynamicPhotosFullSet =
              dynamicPhotoLimit > 0
                ? normalized.slice(0, dynamicPhotoLimit)
                : normalized;

            // Sort by orientation for smoother viewing
            dynamicPhotosFullSet = await sortPhotosByOrientation(dynamicPhotosFullSet);

            dynamicPhotos = filterStaticPhotosByStyle(
              dynamicPhotosFullSet,
              loraStyle,
            );
            writePhotoArrayCache(loraStyle, true, dynamicPhotos);
            dynamicPhotosLoaded = true;
            debugLog(
              `✅ Loaded ${dynamicPhotosFullSet.length} full-library photos from API; filtered to ${dynamicPhotos.length} for style: ${loraStyle}`,
            );
            if (usedAlbum && usedAlbum !== `${album}`) {
              debugWarn(
                `[PhotoLayout] Full library album "${album}" resolved as "${usedAlbum}"`,
              );
            }
          } else {
            debugWarn(
              `[PhotoLayout] No full-library photos returned from API for album "${album}"`,
            );
          }

          if (loadingEl) loadingEl.style.display = "none";
          return dynamicPhotos;
        } catch (error) {
          debugError("Failed to load dynamic photos:", error);
          if (loadingEl) {
            loadingEl.innerHTML =
              '<p class="error">Failed to load photos from API</p>';
            setTimeout(() => {
              if (loadingEl) loadingEl.style.display = "none";
            }, 3000);
          }
          return [];
        }
      }

      async function loadInitialAlbumPhotos(loraStyle = "random") {
        const stored = readPhotoArrayCache(loraStyle, false);
        if (stored.length > 0) {
          debugLog(
            `[PhotoLayout] Using persisted static photo array (${stored.length}) for style: ${loraStyle}`,
          );
          return stored;
        }

        if (!album) return [];

        try {
          if (loadingEl) loadingEl.style.display = "flex";

          const baseUrl =
            (window as typeof window & { PUBLIC_SKICYCLERUN_API?: string })
              .PUBLIC_SKICYCLERUN_API || "https://api.skicyclerun.com/v2/";
          const loraParam = loraStyle === "random" ? "" : `&loraStyle=${loraStyle}`;
          const candidates = buildAlbumCandidates(album);
          let photoArray: any[] = [];

          for (const candidate of candidates) {
            const photoURL = `${baseUrl}getphotosrandom?bucketName=skicyclerun.lib&albumPath=albums/${encodeURIComponent(candidate)}/&numPhotos=${buildTimePhotoLimit}${loraParam}`;
            const res = await fetch(photoURL);
            const data = await res.json();
            const parsed = parseApiPhotoArray(data);
            if (parsed.length > 0) {
              photoArray = parsed;
              break;
            }
          }

          if (photoArray.length === 0) return [];

          const normalized = photoArray
            .map((p, i) => {
              const src =
                typeof p === "string"
                  ? p
                  : p?.src || p?.url || p?.image || p?.imageUrl;
              if (!src) return null;
              const w = p?.width != null ? parseInt(String(p.width), 10) : undefined;
              const h = p?.height != null ? parseInt(String(p.height), 10) : undefined;
              return {
                src,
                altText: p?.altText || `Photo ${i + 1}`,
                alt: p?.alt,
                loraStyle: p?.loraStyle || p?.lora_style || p?.style,
                sourceType: "remote",
                width: w && w > 0 ? w : undefined,
                height: h && h > 0 ? h : undefined,
              };
            })
            .filter(Boolean);

          const sorted = await sortPhotosByOrientation(normalized);
          writePhotoArrayCache(loraStyle, false, sorted);
          return sorted;
        } catch (error) {
          debugError("[PhotoLayout] Failed to load initial album photos", error);
          return [];
        } finally {
          if (loadingEl) loadingEl.style.display = "none";
        }
      }

      function updateViewContent(photos) {
        debugLog(
          `[PhotoLayout] Updating view content with ${photos.length} photos`,
        );

        currentPhotos = Array.isArray(photos) ? photos : [];

        activePhotoCount = photos.length;

        // 1:1 restoration: try src match first (survives fetches returning photos
        // in a different order). activePhotoSrc was set by resolveInitialPhotoState
        // from the sessionStorage store or the URL ?src param — never from stale DOM.
        if (activePhotoSrc) {
          const restoredBySrc = findPhotoIndexBySource(photos, activePhotoSrc);
          if (restoredBySrc >= 0) {
            activePhotoIndex = restoredBySrc;
          }
          // If src not found, keep activePhotoIndex as-is (came from store/URL).
        }

        activePhotoIndex = normalizePhotoIndex(
          activePhotoIndex,
          activePhotoCount,
          0,
        );
        const activePhoto = photos[activePhotoIndex] || photos[0] || null;
        if (activePhoto?.src) {
          activePhotoSrc = activePhoto.src;
        }
        if (album) setActivePhotoState(album, activePhotoIndex, activePhotoSrc);
        layoutRoot?.setAttribute(
          "data-active-photo-index",
          String(activePhotoIndex),
        );
        if (activePhotoSrc) {
          layoutRoot?.setAttribute("data-active-photo-src", activePhotoSrc);
        }
        updateActiveCounter();
        scheduleRotateHintVisibility();

        // Update Hero view
        const heroContainer = sections.hero;
        if (heroContainer && photos.length > 0) {
          // Update the JSON data that Hero view uses for navigation
          const heroJsonScript = heroContainer.querySelector(
            'script[type="application/json"]#hero-photos',
          );
          if (heroJsonScript) {
            heroJsonScript.textContent = JSON.stringify(photos).replace(
              /</g,
              "\\u003c",
            );
            debugLog("[PhotoLayout] Hero JSON updated");
          }

          const heroFigure = heroContainer.querySelector(
            "figure[data-photos-json]",
          ) as HTMLElement | null;
          const heroImg = heroContainer.querySelector(
            "img",
          ) as HTMLImageElement | null;
          const heroPhoto = photos[activePhotoIndex] || photos[0];
          if (heroFigure && heroImg && heroPhoto) {
            heroFigure.setAttribute(
              "data-active-photo-index",
              String(activePhotoIndex),
            );
            heroFigure.setAttribute("data-active-photo-src", heroPhoto.src);
            heroImg.src = heroPhoto.src;
            heroImg.alt = heroPhoto.altText || heroPhoto.alt || "Photo";
            heroImg.dataset.currentIndex = String(activePhotoIndex);
            heroFigure.style.setProperty("--hero-bg", `url("${heroPhoto.src}")`);
            const counterEl = heroFigure.querySelector(
              "#hero-counter",
            ) as HTMLElement | null;
            if (counterEl && photos.length > 1) {
              counterEl.textContent = `${activePhotoIndex + 1} / ${photos.length}`;
            }
          }

          heroFigure?.dispatchEvent(
            new CustomEvent("hero-update", {
              detail: { photos, activeIndex: activePhotoIndex },
            }),
          );
        }

        // Update Gallery view — dispatch event for MDXGalleryView to handle
        const galleryContainer = sections.gallery;
        if (galleryContainer && photos.length > 0) {
          const galleryDiv = galleryContainer.querySelector(".mdx-gallery");
          if (galleryDiv) {
            if (activePhoto?.src) {
              galleryDiv.setAttribute("data-active-photo-src", activePhoto.src);
            }
            galleryDiv.dispatchEvent(
              new CustomEvent("gallery-update", {
                detail: { photos, activeIndex: activePhotoIndex },
                bubbles: false,
              }),
            );
            debugLog(
              `[PhotoLayout] Gallery update event dispatched (${photos.length} photos)`,
            );
          }
        }
        // Update Carousel view
        const carouselContainer = sections.carousel;
        if (carouselContainer) {
          const carouselRoot = carouselContainer.querySelector(
            ".carousel-container",
          ) as HTMLElement | null;

          // Update the JSON data for carousel
          const carouselJsonScript = carouselContainer.querySelector(
            'script[type="application/json"]',
          );
          if (carouselJsonScript) {
            carouselJsonScript.textContent = JSON.stringify(photos).replace(
              /</g,
              "\\u003c",
            );
            debugLog("[PhotoLayout] Carousel JSON updated");
          }

          // Find the carousel track and slides
          const track = carouselContainer.querySelector(".carousel-track");
          if (track) {
            // Rebuild slides using clones of existing SSR nodes so Astro-scoped CSS still applies.
            const existingSlides = Array.from(
              track.querySelectorAll(".carousel-slide"),
            );
            const templateSlide = existingSlides[0] || null;

            if (templateSlide) {
              track.replaceChildren();
              photos.forEach((photo, i) => {
                const slide = templateSlide.cloneNode(true);
                if (!(slide instanceof HTMLElement)) return;

                slide.setAttribute("data-src", photo.src);
                const img = slide.querySelector("img");
                if (img) {
                  img.src = photo.src;
                  img.alt = photo.altText || `Photo ${i + 1}`;
                }

                track.appendChild(slide);
              });
            }

            const selectedView =
              (document.querySelector('input[name="photo-view"]:checked') as HTMLInputElement | null)?.value ||
              "gallery";
            const shouldPlayCarousel = selectedView === "carousel";

            // Reset carousel to first slide and force re-initialize only when carousel is visible.
            if (carouselRoot && shouldPlayCarousel) {
              if (activePhoto?.src) {
                carouselRoot.setAttribute("data-active-photo-src", activePhoto.src);
              }
              carouselRoot.dataset.carouselPlaying = "1";
              delete carouselRoot.dataset.carouselInitialized;

              const intervalId = carouselRoot.dataset.carouselInterval;
              if (intervalId) {
                clearInterval(Number(intervalId));
                delete carouselRoot.dataset.carouselInterval;
              }

              if (track) track.scrollLeft = 0;

              const event = new CustomEvent("reinit-carousel", {
                detail: {
                  containerId: carouselRoot.id,
                  activeIndex: activePhotoIndex,
                },
              });
              document.dispatchEvent(event);
            } else if (carouselRoot) {
              carouselRoot.dataset.carouselPlaying = "0";
            }

            debugLog(
              `[PhotoLayout] Carousel slides rebuilt with ${photos.length} photos and reinitialized`,
            );
          }
        }

        scheduleRotateHintVisibility();

      }

      // Track whether this is the very first update call (page load).
      // We bootstrap photos client-side so static builds do not call remote APIs.
      let isInitialLoad = true;

      async function update() {
        const checked = document.querySelector(
          'input[name="photo-view"]:checked',
        ) as HTMLInputElement | null;
        const value =
          checked?.value === "gallery" || checked?.value === "carousel"
            ? checked.value
            : "hero";
        if (album) setPhotoViewState(album, value);
        const useDynamic = dynamicCheckbox?.checked || false;
        const loraStyle = loraSelect?.value || "random";

        // Always: show/hide the selected view section
        Object.keys(sections).forEach((k) => {
          const el = sections[k];
          if (!el) return;
          el.style.display = k === value ? "" : "none";
        });

        // Hero view has its own in-frame counter pill; hide the layout counter
        // there to avoid duplicate counters in the same corner.
        if (photoActiveCounter) {
          photoActiveCounter.style.display =
            value === "hero" || value === "carousel" ? "none" : "";
        }

        const carouselContainer = sections.carousel;
        const carouselRoot = carouselContainer?.querySelector(
          ".carousel-container",
        ) as HTMLElement | null;
        if (carouselRoot) {
          const shouldPlayCarousel = value === "carousel";
          carouselRoot.dataset.carouselPlaying = shouldPlayCarousel ? "1" : "0";
          if (!shouldPlayCarousel) {
            const intervalId = carouselRoot.dataset.carouselInterval;
            if (intervalId) {
              clearInterval(Number(intervalId));
              delete carouselRoot.dataset.carouselInterval;
            }
          }
        }

        syncViewsToActiveState();

        if (value === "carousel" && carouselRoot) {
          document.dispatchEvent(
            new CustomEvent("reinit-carousel", {
              detail: {
                containerId: carouselRoot.id,
                activeIndex: activePhotoIndex,
              },
            }),
          );
        }

        if (isInitialLoad && !useDynamic && loraStyle === "random") {
          const bootstrapPhotos = await loadInitialAlbumPhotos("random");
          if (bootstrapPhotos.length > 0) {
            staticPhotos = bootstrapPhotos;
            updateStyleAvailability(staticPhotos);
            updateViewContent(bootstrapPhotos);
          }
          isInitialLoad = false;
          return;
        }
        isInitialLoad = false;

        if (useDynamic) {
          // Full Image Library — load all photos from API
          const photos = await loadDynamicPhotos(loraStyle);
          if (photos.length > 0) {
            updateViewContent(photos);
          }
        } else {
          // Static photos filtered by art style
          if (staticPhotos.length === 0) {
            staticPhotos = getStaticPhotos();
            if (staticPhotos.length === 0) {
              staticPhotos = await loadInitialAlbumPhotos("random");
            }
            // Sort by orientation for smoother viewing
            staticPhotos = await sortPhotosByOrientation(staticPhotos);
            updateStyleAvailability(staticPhotos);
          }
          const filteredPhotos = filterStaticPhotosByStyle(
            staticPhotos,
            loraStyle,
          );
          if (filteredPhotos.length > 0) {
            updateViewContent(filteredPhotos);
          }
        }
      }

      function updateStyleAvailability(photos) {
        if (!loraSelect) return;
        const styleValues = ["Afremov", "Gorillaz", "Origami", "PencilDrawing", "FractalGeometry", "purus"];
        styleValues.forEach((style) => {
          const opt = loraSelect.querySelector(`option[value="${style}"]`) as HTMLOptionElement | null;
          if (!opt) return;
          let filtered;
          if (style === "purus") {
            filtered = photos.filter((photo) => {
              let s = photo.loraStyle || photo.lora_style || photo.LoraStyle || photo.style;
              if (!s && photo.src) {
                const m = photo.src.split("/").pop().match(/_([A-Za-z]+)_\d+\./);
                if (m && m[1]) s = m[1];
              }
              return s === "NoLoRA";
            });
          } else {
            filtered = photos.filter((photo) => {
              let s = photo.loraStyle || photo.lora_style || photo.LoraStyle || photo.style;
              if (!s && photo.src) {
                const m = photo.src.split("/").pop().match(/_([A-Za-z]+)_\d+\./);
                if (m && m[1]) s = m[1];
              }
              return s === style;
            });
          }
          const unavailable = filtered.length === 0;
          opt.disabled = unavailable;
          opt.style.color = unavailable ? "rgba(128,128,128,0.5)" : "";
          opt.style.fontStyle = unavailable ? "italic" : "";
        });
      }

      radios.forEach((r) => r.addEventListener("change", update));
      dynamicCheckbox?.addEventListener("change", update);
      loraSelect?.addEventListener("change", () => update());

      document.addEventListener(PHOTO_ACTIVE_INDEX_CHANGE_EVENT, (event) => {
        const detail = (event as CustomEvent).detail || {};
        const sourceView = `${detail.sourceView || ""}`;
        const nextSrc = `${detail.src || ""}`;
        const parsedIndex = Number(detail.index);

        if (Number.isFinite(parsedIndex)) {
          activePhotoIndex = Math.max(0, Math.trunc(parsedIndex));
        }

        if (nextSrc) {
          activePhotoSrc = nextSrc;
          layoutRoot?.setAttribute("data-active-photo-src", nextSrc);
          if (Array.isArray(currentPhotos) && currentPhotos.length > 0) {
            const srcMatchedIndex = findPhotoIndexBySource(currentPhotos, nextSrc);
            if (srcMatchedIndex >= 0) {
              activePhotoIndex = srcMatchedIndex;
              activePhotoSrc = currentPhotos[srcMatchedIndex]?.src || nextSrc;
            }
          }
        }

        if (album) setActivePhotoState(album, activePhotoIndex, activePhotoSrc);

        syncViewsToActiveState(sourceView);

        if (isFullPageMode) {
          window.setTimeout(syncFullModePhotoState, 0);
          window.setTimeout(scheduleRotateHintVisibility, 0);
        }
      });

      // On load: show the correct default section (gallery). Views are already
      // populated from SSR — no API call needed here.
      update();
      updateActiveCounter();
    });
  </script>
</article>

<style>
  :global(body.photo-full-page-active) {
    overflow: hidden;
    background: #000;
  }

  .photo-layout {
    --photo-frame-max-width: 1024px;
    --photo-frame-radius: clamp(0.9rem, 2.6vw, 1.8rem);
    --photo-frame-aspect: 1 / 1;
    --photo-nav-label-padding: 0.35rem 0.72rem;
    --photo-nav-gap: 0.55rem;
    --photo-stage-shadow: 0 24px 60px rgba(0, 0, 0, 0.22);
    width: min(100%, var(--photo-frame-max-width));
    max-width: var(--photo-frame-max-width);
    margin-left: auto;
    margin-right: auto;
    padding: 0 clamp(0.35rem, 2.4vw, 1.25rem);
    box-sizing: border-box;
  }

  .photo-layout-header {
    max-width: min(100%, var(--photo-frame-max-width));
    margin: 0 auto;
    padding: 0.2rem 0.4rem 0;
    animation: photo-enter-up 420ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }

  .photo-controls-wrap {
    max-width: min(100%, var(--photo-frame-max-width));
    margin: 0 auto;
    animation: photo-enter-up 520ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
    animation-delay: 60ms;
  }

